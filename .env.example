NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
AI_MEMORY_PROVIDER=openrouter
GEMINI_API_KEY=
GEMINI_MEMORY_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MEMORY_MODEL=deepseek/deepseek-v4-flash
OPENAI_API_KEY=
OPENAI_MEMORY_MODEL=gpt-5.6-terra
# Optional. Requests per 10 minutes per IP for the public memory-engine endpoint.
# Defaults to 60 when unset. See lib/rate-limit.ts for the per-instance caveat.
MEMORY_ENGINE_RATE_LIMIT=

# Daily reminders by push notification (optional — calendar reminders work without these).
# Generate keys with: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@lifeonpaper.app
# Server-only. Lets /api/reminders store subscriptions and the sender read them.
SUPABASE_SERVICE_ROLE_KEY=
# Shared with the GitHub repository secret of the same name (.github/workflows/send-reminders.yml).
CRON_SECRET=
